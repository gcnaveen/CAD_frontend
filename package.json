    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router": "^8.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.5",
