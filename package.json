    "check:secrets": "node scripts/check-l03-frontend-secrets.mjs",
    "test:m04": "npm run lint && npm run check:hygiene",
    "optimize:media": "node scripts/optimize-media.mjs",
    "fonts:woff2": "node scripts/fonts-to-woff2.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lighthouse:ci": "echo \"Install @lhci/cli locally to run Lighthouse CI (removed from deps for audit hygiene)\" && exit 1",
    "test:m05": "npm run build && npm run check:bundle"
