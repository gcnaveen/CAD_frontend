# API Gateway URL for serverless Lambda backend (no trailing slash)
# Get this from your AWS API Gateway console
# Format: https://<api-id>.execute-api.<region>.amazonaws.com
# Stage (dev-cad-backend-api) — CORS allow-lists https://north-cot.com with credentials
VITE_API_BASE_URL=https://jpb5bsbvkg.execute-api.ap-south-1.amazonaws.com

# If your API Gateway has a custom domain:
# VITE_API_BASE_URL=https://api.yourdomain.com

# L-01: public site origin for canonical / Open Graph absolute URLs (no trailing slash).
# Keep public/robots.txt + public/sitemap.xml host in sync if this differs.
# VITE_SITE_URL=https://northcot.in

# M-01 (backend / ops — not a Vite var): production API must allow-list this app's
# browser origins. Never use *. Remove localhost from prod.
# Example (match every origin that hosts this SPA):
# CORS_ALLOW_ORIGINS=https://north-cot.com,https://www.north-cot.com
# HTML-site headers (CSP, nosniff, mic=(self) for voice notes):
#   security/m01-headers.json → npm run sync:headers
#   docs/SECURITY_M01_CORS_HEADERS.md

# H-05: show build provenance footer (GET /api/version) outside Vite DEV
# VITE_SHOW_BUILD_FOOTER=true
